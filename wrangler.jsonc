{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "for-jackie",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // HTML pages go through the Worker for edge rendering (src/ssr.js) —
    // crawlers must see live content. Everything else (css/js/fonts/images)
    // stays on the fast asset path.
    "run_worker_first": ["/", "/updates", "/rumors", "/timeline", "/record", "/wall", "/about", "/help"]
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "forjackie.org", "custom_domain": true },
    { "pattern": "www.forjackie.org", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "93ac213d403145e3ab7ffa597f2e057a"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
